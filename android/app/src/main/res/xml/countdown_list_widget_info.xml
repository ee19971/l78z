<?xml version="1.0" encoding="utf-8"?>
<!--
  倒数日列表部件的元信息。

  minHeight/resizeMode 与 life_progress_widget_info 保持同款写法
  （排查期对齐的，无害）。列表真正的历史坑不在这里，在 ListWidget
  类注释里：ListView/RemoteViewsService、RemoteViews.addView、
  以及 R8 对 const val 布局常量的错误优化（layoutId=0）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/countdown_list_widget"
    android:minHeight="70dp"
    android:minWidth="180dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/countdown_list_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
