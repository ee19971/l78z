<?xml version="1.0" encoding="utf-8"?>
<!-- 倒数日列表部件容器。

     整个列表是一个 TextView 的多行纯文本（只走 setText 指令）——
     HyperOS 桌面（Flutter/Rust 自研渲染）只支持基础 RemoteViews 指令子集：
     ListView/RemoteViewsService、RemoteViews.addView、带 span 的富文本
     全都会让部件显示「载入窗口小部件时出现问题」。

     属性写法与 life_progress_widget 保持同源（整块 padding、垂直方向
     不用 0dp+weight、不加 lineSpacingExtra），每个属性都能在单日/人生
     部件的布局里找到成功先例——HyperOS 的布局解析器只认属性子集，
     引入新写法等于重新抽奖。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_list_title"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 多行文本列表：每行「天数　　状态 · 日期」，行数由代码按部件高度决定。
         高度必须 wrap_content：垂直布局里的 0dp+weight 属于未验证写法，
         宁可用最朴素的写法。 -->
    <TextView
        android:id="@+id/list_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp" />
</LinearLayout>
