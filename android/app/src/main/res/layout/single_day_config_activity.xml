<?xml version="1.0" encoding="utf-8"?>
<!-- 单日部件配置页（原生 Activity，不是 Flutter 页）。
     这个页由系统在添加部件时拉起，必须秒开，所以用纯 Kotlin 布局。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/config_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_config_hint"
        android:textColor="?android:textColorSecondary"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/event_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:divider="?android:listDivider"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/empty_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_config_empty"
        android:textColor="?android:textColorSecondary"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_config_confirm" />
</LinearLayout>
